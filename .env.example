# scale94 — environment variables (example)
# Copy to .env.local and fill in real values.

# ── GraphTracks (server only: api/graphtracks/top-posts) ───────────────────
# Never prefix these with VITE_ — that would put them in the browser bundle.
GRAPHTRACKS_KEY=
GRAPHTRACKS_DID=

# ── Classified routes (server only: api/classified/*) ──────────────────────
SESSION_SECRET=
CLASSIFIED_AES_KEY=
CLASSIFIED_AES_IV=
CLASSIFIED_AES_CIPHERTEXT=
CLASSIFIED_AES_TAG=
# Optional. Classified routes read this and allow any origin while it is unset.
# ALLOWED_ORIGIN=
