# scale94 — environment variables (example)
# Copy to .env.local and fill in real values.

# ── GraphTracks (server only: api/graphtracks/top-posts) ───────────────────
# Never prefix these with VITE_ — that would put them in the browser bundle.
GRAPHTRACKS_KEY=
GRAPHTRACKS_DID=

# ── Transmute orders (server only: api/transmute/order) ────────────────────
# Without the bot token and channel, orders are saved but never posted to Discord.
DISCORD_BOT_TOKEN=
DISCORD_ORDER_CHANNEL_ID=
# Secret key for hashing caller addresses in the rate limiter. Required:
# orders answer 503 while it is unset. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
# Optional. Browser POSTs to /api/transmute/order are accepted from the site's
# own origin; name one other origin here to accept it too. The classified routes
# read this as well, and allow any origin while it is unset.
# ALLOWED_ORIGIN=

# ── Discord buttons (server only: api/discord/interactions) ────────────────
# The application's public key from the Developer Portal. Required: every
# interaction is refused while it is unset.
DISCORD_APPLICATION_PUBLIC_KEY=

# ── Classified routes (server only: api/classified/*) ──────────────────────
SESSION_SECRET=
CLASSIFIED_AES_KEY=
CLASSIFIED_AES_IV=
CLASSIFIED_AES_CIPHERTEXT=
CLASSIFIED_AES_TAG=

# ── Living Accord (Phase 4) ─────────────────────────────────────────────────
# Shared HS256 secret with the Discord bot (bot/.env).
# Used by /api/transmute/redeem to verify sovereign keys issued by the bot.
DISCORD_SOVEREIGN_SECRET=

# ── Vercel KV (optional — used for production threshold + redeem idempotency) ─
KV_REST_API_URL=
KV_REST_API_TOKEN=
