# scale94 — environment variables (example)
# Copy to .env.local and fill in real values.

# ── Crystallize / Tesseract (existing) ──────────────────────────────────────
VITE_CRYSTAL_WEBHOOK=

# ── GraphTracks (server only: api/graphtracks/top-posts) ───────────────────
# Never prefix these with VITE_ — that would put them in the browser bundle.
GRAPHTRACKS_KEY=
GRAPHTRACKS_DID=

# ── Living Accord (Phase 4) ─────────────────────────────────────────────────
# Shared HS256 secret with the Discord bot (bot/.env).
# Used by /api/transmute/redeem to verify sovereign keys issued by the bot.
DISCORD_SOVEREIGN_SECRET=

# ── Vercel KV (optional — used for production threshold + redeem idempotency) ─
KV_REST_API_URL=
KV_REST_API_TOKEN=
